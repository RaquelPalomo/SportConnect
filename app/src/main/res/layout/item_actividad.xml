<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#22FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Franja superior — naranja normal o roja si cancelada -->
        <View
            android:id="@+id/viewFranja"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="#FF6B35"
            android:layout_marginBottom="12dp" />

        <!-- Aviso cancelación — oculto por defecto -->
        <LinearLayout
            android:id="@+id/layoutCancelada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#33FF0000"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Clase cancelada por el profesional"
                android:textSize="13sp"
                android:textColor="#FF6B6B"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yoga"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvProfesor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prof: Carlos García"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLugar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Polideportivo Municipal, Madrid"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/06/2026 - 10:00h"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlazas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Plazas: 5/15"
                android:textSize="13sp"
                android:textColor="#FF6B35"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 min"
                android:textSize="13sp"
                android:textColor="#AAFFFFFF" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>