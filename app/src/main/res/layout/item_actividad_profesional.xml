<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#22FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Franja naranja superior -->
        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="#FF6B35"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLugar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- Inscritos y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvInscritos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#FF6B35"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botones editar y cancelar — solo visibles en pendientes sin inscritos -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Editar"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@null"
                android:background="@drawable/button_gradient"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar clase"
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:backgroundTint="@null"
                android:background="@android:color/transparent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#FF6B35"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Solo botón cancelar si hay inscritos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarSolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar clase"
            android:textSize="12sp"
            android:textColor="#FF6B35"
            android:backgroundTint="@null"
            android:background="@android:color/transparent"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#FF6B35"
            app:strokeWidth="1dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>