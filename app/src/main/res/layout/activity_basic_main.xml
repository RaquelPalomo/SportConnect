<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <!-- Barra superior -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#22FFFFFF"
        android:title="SportConnect"
        app:titleTextColor="#FFFFFF" />

    <!-- Filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#22FFFFFF">

        <!-- Dropdown tipo de actividad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFiltroTipo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tipo de actividad"
            android:layout_marginEnd="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            app:hintTextColor="#FFFFFF"
            app:boxStrokeColor="#FF6B35"
            app:boxBackgroundColor="#22FFFFFF">

            <AutoCompleteTextView
                android:id="@+id/etFiltroTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo población -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Población"
            android:layout_marginStart="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:hintTextColor="#FFFFFF"
            app:boxStrokeColor="#FF6B35"
            app:boxBackgroundColor="#22FFFFFF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFiltroPoblacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFiltrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Buscar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="@null"
        android:background="@drawable/button_gradient"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Lista de actividades -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerActividades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Mensaje cuando no hay actividades -->
    <TextView
        android:id="@+id/tvSinActividades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No hay actividades disponibles"
        android:textSize="16sp"
        android:textColor="#AAFFFFFF"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#FF6B35"
        android:visibility="gone" />

</LinearLayout>