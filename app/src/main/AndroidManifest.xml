        </activity>

        <activity android:name=".ui.auth.RegistroActivity" />
        <activity android:name=".ui.basic.BasicMainActivity" />
        <activity android:name=".ui.professional.ProfessionalMainActivity" />
        <activity android:name=".ui.admin.AdminMainActivity" />
